{
  "name": "Factorial Academy · JEE Maths Tracker",
  "short_name": "Factorial",
  "description": "Every Factorial Academy JEE Maths video, chapter by chapter. Lessons play inside the app, progress and revision are tracked, and the watcher pulls in new uploads by itself.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0A0D16",
  "theme_color": "#0A0D16",
  "categories": [
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "lang": "en",
  "dir": "ltr",
  "orientation": "any",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "shortcuts": [
    {
      "name": "Play where I left off",
      "short_name": "Play",
      "url": "./#play",
      "description": "Open the next unwatched lesson in the player."
    },
    {
      "name": "Keep watching",
      "short_name": "Continue",
      "url": "./#top",
      "description": "Jump back to the next unwatched lesson."
    },
    {
      "name": "Check for new videos",
      "short_name": "New videos",
      "url": "./#sync",
      "description": "Ask YouTube for uploads you have not got yet."
    },
    {
      "name": "Channel and new uploads",
      "short_name": "Channel",
      "url": "./#channel",
      "description": "Latest videos from Factorial Academy."
    },
    {
      "name": "Connect",
      "short_name": "Connect",
      "url": "./#connect",
      "description": "YouTube, Telegram, email and more."
    },
    {
      "name": "Questions people ask",
      "short_name": "FAQ",
      "url": "./#faq",
      "description": "How the tracker works."
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
